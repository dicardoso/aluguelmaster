# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Configuration for Email Notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# APP_ENV: which environment this is — "production", "develop" (homologação) or "local".
# Unset counts as "local". Outside production, emails are never sent (only logged), an
# environment badge is shown in the UI, and Firebase must be configured explicitly below.
APP_ENV=local

# DATABASE_URL: Neon (Postgres) connection string. Server-only — never exposed to the client.
# Each environment uses its own Neon branch: production=main, develop=develop, local=local.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# PRODUCTION_DATABASE_HOST (optional, develop/local only): the production Neon endpoint id,
# e.g. "ep-xxxx-yyyy" — host only, no credentials. If DATABASE_URL contains it while
# APP_ENV is not production, the server refuses to start.
PRODUCTION_DATABASE_HOST=

# Firebase web config (public values, inlined into the client bundle at build time).
# Required when APP_ENV is develop/local — use the non-production Firebase project.
# In production these may be omitted: the committed firebase-applet-config.json is used.
# VITE_FIREBASE_PROJECT_ID is also what the server uses to verify ID tokens.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# SETTINGS_ENCRYPTION_KEY: encrypts the SMTP password at rest in Postgres. Server-only —
# unlike the old VITE_ENCRYPTION_KEY, this is never bundled into the client.
SETTINGS_ENCRYPTION_KEY=
